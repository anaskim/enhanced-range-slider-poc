---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection
    id="interaction-mode"
    eyebrow="Interaction modes"
    title="Interaction mode (working name)"
    status="gap"
    runtimeRequires={["core", "convenienceApi"]}
>
    <Fragment slot="description">
        Compare endpoint-oriented vs range-oriented pointer behavior. The attribute
        <code>interaction</code> with keywords <code>endpoints</code> (default) and
        <code>range</code> is a <strong>working name</strong> for Open UI bikeshed on
        <a href="https://github.com/openui/open-ui/issues/1460">#1460</a> — not a committed HTML API. Do not use <code
            >draggable</code
        >. In <code>range</code> mode a track press never moves a single thumb: pressing between two thumbs drags that interval
        and keeps its width, and pressing <em>outside</em> it pulls the nearest interval to the pointer instead. Only dragging
        a thumb directly changes one end. Keyboard users get the same translate-with-width-preserved action via <kbd
            >Shift</kbd
        >+Arrow on a focused thumb (see <a href="https://github.com/openui/open-ui/issues/1511">#1511</a>). The two
        keywords are deliberately different experiences so they can be compared in user testing, which is what the 10
        September 2026 telecon
        <a href="https://www.w3.org/2026/09/10-openui-minutes.html">resolved</a>. It works with any thumb count &mdash;
        with three or more, the pointer picks which segment moves (see the segment-drag examples further down).
    </Fragment>
    <div slot="demo">
        <style is:global>
            #interaction-mode-range::slider-segment(2) {
                background: var(--color-teal);
                cursor: grab;
            }
        </style>
        <rangegroup id="interaction-mode-range" interaction="range" min="0" max="120">
            <legend class="visually-hidden">Clip in and out points</legend>
            <label class="visually-hidden">
                In
                <input type="range" name="clip-in" min="0" max="120" value="24" />
            </label>
            <label class="visually-hidden">
                Out
                <input type="range" name="clip-out" min="0" max="120" value="84" />
            </label>
        </rangegroup>
        <p class="interaction-mode-readout" id="interaction-mode-readout"></p>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup interaction="range" min="0" max="120">
  <legend>Clip in and out points</legend>
  <label>In <input type="range" name="clip-in" min="0" max="120" value="24"></label>
  <label>Out <input type="range" name="clip-out" min="0" max="120" value="84"></label>
</rangegroup>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
rangegroup::slider-segment(2) {
  background: var(--color-teal);
  cursor: grab;
}
`}
        />
        <CodeSnippet
            lang="javascript"
            code={`
const rg = document.querySelector("#interaction-mode-range");
const inputs = rg.querySelectorAll('input[type="range"]');
const sync = () => console.log(Array.from(rg.values));
inputs.forEach((input) => input.addEventListener("input", sync));
`}
        />
    </ExampleCodeBlock>
    <script is:inline slot="runtime">
        (() => {
            const init = () => {
                const rg = document.querySelector("#interaction-mode-range");
                const readout = document.querySelector("#interaction-mode-readout");
                if (!rg || !readout) return;
                const inputs = rg.querySelectorAll('input[type="range"]');

                const format = (seconds) => {
                    const m = Math.floor(seconds / 60);
                    const s = Math.round(seconds % 60);
                    return `${m}:${String(s).padStart(2, "0")}`;
                };

                const syncReadout = () => {
                    const [a, b] = rg.values;
                    readout.textContent = `In ${format(a)} · Out ${format(b)} · duration ${format(b - a)}`;
                };

                inputs.forEach((input) => input.addEventListener("input", syncReadout));
                syncReadout();
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init, { once: true });
            } else {
                init();
            }
        })();
    </script>
</ExampleSection>
