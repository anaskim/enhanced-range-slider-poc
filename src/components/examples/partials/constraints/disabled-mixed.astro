---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="disabled-mixed" eyebrow="Constraints and state" title="Mixed disabled state">
    <Fragment slot="description">
        Individual thumbs can be disabled while the rest remain interactive. The button toggles the group-level <code
            >disabled</code
        > state to show that individual disabled flags persist on re-enable.
    </Fragment>
    <div slot="demo">
        <style is:global>
            #disabled-mixed-example::slider-segment(2) {
                background-color: var(--color-teal);
            }
            #disabled-mixed-example:has(input[name="dis-mixed-min"]:disabled)::slider-thumb(1) {
                opacity: 0.45;
            }
        </style>
        <rangegroup id="disabled-mixed-example" min="0" max="100">
            <legend class="visually-hidden">Mixed disabled</legend>
            <label class="visually-hidden">
                Minimum (locked)
                <input type="range" name="dis-mixed-min" value="30" disabled />
            </label>
            <label class="visually-hidden">
                Maximum
                <input type="range" name="dis-mixed-max" value="70" />
            </label>
        </rangegroup>
        <div class="button-group">
            <button id="toggleDisabledBtn" class="btn btn-primary">Toggle group disabled</button>
        </div>
        <output id="disabledOutput" class="api-output">Group disabled: false</output>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup id="disabled-mixed-example" min="0" max="100">
  <legend>Mixed disabled</legend>
  <label>Minimum (locked) <input type="range" value="30" disabled></label>
  <label>Maximum <input type="range" value="70"></label>
</rangegroup>
<button id="toggleDisabledBtn">Toggle group disabled</button>
<output id="disabledOutput">Group disabled: false</output>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
rangegroup::slider-segment(2) {
  background-color: var(--color-teal);
}
/* Thumb geometry and color come from UA styles. */
rangegroup:has(input[name="dis-mixed-min"]:disabled)::slider-thumb(1) {
  opacity: .45;
}
rangegroup[disabled] {
  opacity: .58;
}
`}
        />
        <CodeSnippet
            lang="javascript"
            code={`
const rg     = document.querySelector("#disabled-mixed-example");
const btn    = document.querySelector("#toggleDisabledBtn");
const output = document.querySelector("#disabledOutput");

btn.addEventListener("click", () => {
  rg.disabled = !rg.disabled;
  output.value = \`Group disabled: \${rg.disabled}\`;
  /* The first input keeps its own \`disabled\` attribute, so
     toggling the group back on leaves it locked. */
});
`}
        />
    </ExampleCodeBlock>
    <script is:inline slot="runtime">
        (() => {
            const init = () => {
                const rg = document.querySelector("#disabled-mixed-example");
                const btn = document.querySelector("#toggleDisabledBtn");
                const output = document.querySelector("#disabledOutput");

                btn.addEventListener("click", () => {
                    rg.disabled = !rg.disabled;
                    output.value = `Group disabled: ${rg.disabled}`;
                    /* The first input keeps its own `disabled` attribute, so
                     toggling the group back on leaves it locked. */
                });
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init, { once: true });
            } else {
                init();
            }
        })();
    </script>
</ExampleSection>
