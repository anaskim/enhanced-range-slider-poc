---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="custom-ticks" eyebrow="Creative styling" title="Custom tick styling" status="partial">
    <Fragment slot="description">
        Individual ticks and tick labels can be styled via the proposed slider pseudos. The 50% tick is highlighted with
        a different colour and height.
    </Fragment>
    <Fragment slot="disclosure">
        The explainer proposes <code>::slider-tick(*)</code> and <code>::slider-tick-label</code>. This prototype
        deferred their public styling API while it investigates stable group-wide ticks versus active-thumb filtering,
        option-label rendering, indexing, CSSOM, and dynamic updates. Native tick generation and snapping are already
        implemented.
    </Fragment>
    <div slot="demo">
        <style is:global>
            .custom-tick-output {
                position: relative;
                block-size: 2rem;
                margin-top: -7px;
                color: var(--text-soft);
                text-align: center;
            }
            .custom-tick-output span {
                position: absolute;
                inset-inline-start: var(--custom-tick-position);
                padding-top: 10px;
                translate: -50% 0;
                white-space: nowrap;
                font-size: 0.75rem;
            }
            .custom-tick-output span::before {
                position: absolute;
                inset-block-start: 0;
                inset-inline-start: 50%;
                width: 1px;
                height: 8px;
                translate: 0 0;
                background: currentColor;
                content: "";
            }
            .custom-tick-output span:nth-child(3) {
                color: var(--color-pink);
                font-weight: 700;
            }
            .custom-tick-output span:nth-child(3)::before {
                width: 3px;
                height: 16px;
                translate: -50% 0;
            }
        </style>
        <rangegroup id="custom-ticks-example" min="0" max="100" list="custom-ticks-datalist">
            <legend class="visually-hidden">Custom tick styling</legend>
            <label class="visually-hidden">Value 1 <input type="range" value="25" /></label>
            <label class="visually-hidden">Value 2 <input type="range" value="75" /></label>
        </rangegroup>
        <datalist id="custom-ticks-datalist">
            <option value="0" label="0%"></option>
            <option value="25"></option>
            <option value="50" label="50%"></option>
            <option value="75"></option>
            <option value="100" label="100%"></option>
        </datalist>
        <div class="custom-tick-output" aria-hidden="true">
            <span style="--custom-tick-position: 0%">0%</span>
            <span style="--custom-tick-position: 25%">25</span>
            <span style="--custom-tick-position: 50%">50%</span>
            <span style="--custom-tick-position: 75%">75</span>
            <span style="--custom-tick-position: 100%">100%</span>
        </div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup min="0" max="100" list="custom-ticks-datalist">
  <legend>Custom tick styling</legend>
  <label>Value 1 <input type="range" value="25"></label>
  <label>Value 2 <input type="range" value="75"></label>
</rangegroup>

<datalist id="custom-ticks-datalist">
  <option value="0"   label="0%"></option>
  <option value="25"></option>
  <option value="50"  label="50%"></option>
  <option value="75"></option>
  <option value="100" label="100%"></option>
</datalist>

<div class="custom-tick-output" aria-hidden="true">
  <span style="--custom-tick-position: 0%">0%</span>
  <span style="--custom-tick-position: 25%">25</span>
  <span style="--custom-tick-position: 50%">50%</span>
  <span style="--custom-tick-position: 75%">75</span>
  <span style="--custom-tick-position: 100%">100%</span>
</div>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
/* Current prototype: overlay the proposed appearance on native tick positions. */
.custom-tick-output {
  position: relative;
  block-size: 2rem;
  margin-top: -7px;
  color: var(--text-soft);
  text-align: center;
}
.custom-tick-output span {
  position: absolute;
  inset-inline-start: var(--custom-tick-position);
  padding-top: 10px;
  translate: -50% 0;
  white-space: nowrap;
  font-size: .75rem;
}
.custom-tick-output span::before {
  position: absolute;
  inset-block-start: 0;
  inset-inline-start: 50%;
  width: 1px;
  height: 8px;
  translate: 0 0;
  background: currentColor;
  content: "";
}
.custom-tick-output span:nth-child(3) {
  color: var(--color-pink);
  font-weight: bold;
}
.custom-tick-output span:nth-child(3)::before {
  width: 3px;
  height: 16px;
  translate: -50% 0;
}
`}
        />
    </ExampleCodeBlock>
</ExampleSection>
