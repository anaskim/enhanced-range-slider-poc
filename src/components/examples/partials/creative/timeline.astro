---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="timeline" eyebrow="Creative styling" title="Styled timeline">
    <Fragment slot="description">
        Ticks dressed up as milestones on a project timeline. The start, middle, and end ticks are promoted with a
        distinct colour and height.
    </Fragment>
    <div slot="demo">
        <style is:global>
            #timeline-example {
                --track-height: 2px;
            }
            #timeline-example::slider-segment {
                block-size: var(--track-height);
                inset-block-start: 7px;
                border-radius: 0;
                background: #d8d8de;
            }
            #timeline-example::slider-segment(1) {
                border-radius: 999px 0 0 999px;
            }
            #timeline-example::slider-segment(2) {
                background: var(--color-teal);
            }
            #timeline-example::slider-segment(3) {
                border-radius: 0 999px 999px 0;
            }
            .timeline-milestones {
                position: relative;
                block-size: 2.7rem;
                margin-top: -10px;
                color: var(--text-soft);
                text-align: center;
                font-size: 0.75rem;
            }
            .timeline-milestones span {
                position: absolute;
                inset-inline-start: var(--timeline-position);
                translate: -50% 0;
                white-space: nowrap;
                z-index: 1;
            }
            .timeline-milestones span::before {
                display: block;
                width: 2px;
                height: 10px;
                margin: 0 auto 0.3rem;
                background: currentColor;
                content: "";
            }
            .timeline-milestones span:nth-child(odd) {
                color: var(--color-teal);
                font-weight: 700;
            }
            .timeline-milestones span:nth-child(odd)::before {
                width: 4px;
                height: 20px;
            }
            @media (max-width: 700px) {
                .timeline-milestones span {
                    font-size: 0.7rem;
                }
                .timeline-milestones span::before {
                    height: 8px;
                }
                .timeline-milestones span:nth-child(odd)::before {
                    width: 3px;
                    height: 15px;
                }
            }
            @media (max-width: 420px) {
                .timeline-milestones span {
                    font-size: 0.64rem;
                }
            }
        </style>
        <rangegroup id="timeline-example" min="0" max="100" list="timeline-datalist" stepbetween="25">
            <legend class="visually-hidden">Styled timeline</legend>
            <label class="visually-hidden">
                Start Date
                <input type="range" min="0" max="100" step="25" value="25" />
            </label>
            <label class="visually-hidden">
                End Date
                <input type="range" min="0" max="100" step="25" value="75" />
            </label>
        </rangegroup>
        <datalist id="timeline-datalist">
            <option value="0" label="start"></option>
            <option value="25"></option>
            <option value="50" label="mid"></option>
            <option value="75"></option>
            <option value="100" label="End"></option>
        </datalist>
        <div class="timeline-milestones" aria-hidden="true">
            <span style="--timeline-position: 0%">start</span>
            <span style="--timeline-position: 25%">25</span>
            <span style="--timeline-position: 50%">mid</span>
            <span style="--timeline-position: 75%">75</span>
            <span style="--timeline-position: 100%">End</span>
        </div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup min="0" max="100" list="timeline-datalist" stepbetween="25">
  <legend>Project timeline</legend>
  <label>Start date <input type="range" min="0" max="100" step="25" value="25"></label>
  <label>End date   <input type="range" min="0" max="100" step="25" value="75"></label>
</rangegroup>

<datalist id="timeline-datalist">
  <option value="0"   label="start"></option>
  <option value="25"></option>
  <option value="50"  label="mid"></option>
  <option value="75"></option>
  <option value="100" label="End"></option>
</datalist>

<div class="timeline-milestones" aria-hidden="true">
  <span style="--timeline-position: 0%">start</span>
  <span style="--timeline-position: 25%">25</span>
  <span style="--timeline-position: 50%">mid</span>
  <span style="--timeline-position: 75%">75</span>
  <span style="--timeline-position: 100%">End</span>
</div>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
/* a hair-thin track */
rangegroup { --track-height: 2px; }
rangegroup::slider-segment {
  block-size: var(--track-height);
  inset-block-start: 7px;
  background: #d8d8de;
}
rangegroup::slider-segment(2) { background: var(--color-teal); }

.timeline-milestones {
  position: relative;
  block-size: 2.7rem;
  margin-top: -10px;
  color: var(--text-soft);
  text-align: center;
}
.timeline-milestones span {
  position: absolute;
  inset-inline-start: var(--timeline-position);
  translate: -50% 0;
  white-space: nowrap;
  z-index: 1;
}
.timeline-milestones span::before {
  display: block;
  width: 2px;
  height: 10px;
  margin: 0 auto .3rem;
  background: currentColor;
  content: "";
}
.timeline-milestones span:nth-child(odd) {
  color: var(--color-teal);
  font-weight: 700;
}
.timeline-milestones span:nth-child(odd)::before {
  width: 4px;
  height: 20px;
}
`}
        />
    </ExampleCodeBlock>
</ExampleSection>
