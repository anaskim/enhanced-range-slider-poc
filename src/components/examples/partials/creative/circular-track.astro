---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="circular-track" eyebrow="Creative styling" title="Circular track shape" status="gap">
    <Fragment slot="description">
        A two-thumb circular range dial, built entirely with opt-in CSS. Thumbs orbit the ring via <code
            >offset-path</code
        >
        + <code>offset-distance</code>, and the filled arc is a <code>conic-gradient</code> driven by the segment&rsquo;s
        exposed geometry. A tiny opt-in script maps pointer movement to angle so dragging feels truly circular. The value
        chips are purely presentational and intentionally omitted from the code sample.
    </Fragment>
    <Fragment slot="disclosure">
        Fixed-origin, counterclockwise movement is an inferred demo policy, not settled rangegroup behavior. The
        authored angle adapter moves only the second input and clamps rather than wrapping. Native path hit testing,
        event dispatch, keyboard direction, accessibility orientation, and the shared 0%/100% seam remain unresolved.
    </Fragment>
    <div slot="demo" class="circular-card">
        <style is:global>
            .circular-card {
                display: grid;
                justify-items: center;
                gap: 1.25rem;
            }
            #circular-range {
                --ring: 18px;
                --circ-accent: #0a84ff;
                position: relative;
                inline-size: 240px;
                block-size: 240px;
                padding: 0;
            }
            #circular-range::slider-track {
                inline-size: 240px;
                block-size: 240px;
                border-radius: 50%;
                background:
                    radial-gradient(farthest-side, var(--surface-soft) calc(100% - var(--ring)), transparent 0),
                    var(--border-strong);
                box-shadow: none;
            }
            #circular-range::slider-segment {
                inset: 0;
                inline-size: 240px;
                block-size: 240px;
                border-radius: 50%;
                background: transparent;
                pointer-events: none;
            }
            #circular-range::slider-segment(2) {
                background: conic-gradient(
                    from 0deg,
                    transparent 0
                        calc(100% - var(--_blink-rangegroup-prototype-segment-size, var(--circular-segment-size, 75%))),
                    var(--circ-accent)
                        calc(100% - var(--_blink-rangegroup-prototype-segment-size, var(--circular-segment-size, 75%)))
                        100%
                );
                mask: radial-gradient(farthest-side, transparent calc(100% - var(--ring)), #000 0);
            }
            #circular-range::slider-thumb(*) {
                inset: 0;
                inline-size: 24px;
                block-size: 24px;
                margin: 0;
                padding: 0;
                offset-path: path("M120,9 A111,111 0 0 0 120,231 A111,111 0 0 0 120,9");
                offset-distance: var(--_blink-rangegroup-prototype-thumb-position, var(--circular-position));
                offset-anchor: center;
                offset-rotate: 0deg;
                border: 3px solid var(--circ-accent);
                border-radius: 50%;
                background: white;
                box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
            }
            #circular-range::slider-thumb(1) {
                --circular-position: var(--circular-thumb-1-position, 0%);
                opacity: 1;
            }
            #circular-range::slider-thumb(2) {
                --circular-position: var(--circular-thumb-2-position, 75%);
            }
            #circular-range::slider-thumb(*):hover {
                box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
                transform: scale(1.12);
            }
            .circular-readout {
                display: flex;
                gap: 8px;
                align-items: center;
                color: var(--text-muted);
                font-size: 0.9rem;
            }
        </style>
        <rangegroup id="circular-range" min="0" max="100" stepbetween="5">
            <legend class="visually-hidden">Circular range</legend>
            <label class="visually-hidden">Fixed start <input type="range" value="0" disabled /></label>
            <label class="visually-hidden">End <input type="range" value="75" /></label>
        </rangegroup>
        <div class="circular-readout" aria-live="polite">
            <span class="value-chip" id="circ-start">0</span>
            <span>to</span>
            <span class="value-chip" id="circ-end">75</span>
        </div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup id="circular-range" min="0" max="100" stepbetween="5">
  <label>Fixed start <input type="range" value="0" disabled></label>
  <label>End <input type="range" value="75"></label>
</rangegroup>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
rangegroup {
  inline-size: 240px;
  block-size: 240px;
}
rangegroup::slider-track {
  inline-size: 240px;
  block-size: 240px;
  border-radius: 50%;
  background:
    radial-gradient(
      farthest-side,
      var(--surface-soft) calc(100% - 18px),
      transparent 0
    ),
    #c7cbd4;
}
rangegroup::slider-segment(2) {
  inset: 0;
  inline-size: 240px;
  block-size: 240px;
  background: conic-gradient(
    from 0deg,
    transparent 0
      calc(
        100% - var(
          --_blink-rangegroup-prototype-segment-size,
          var(--circular-segment-size, 75%)
        )
      ),
    #0a84ff
      calc(
        100% - var(
          --_blink-rangegroup-prototype-segment-size,
          var(--circular-segment-size, 75%)
        )
      )
      100%
  );
  mask: radial-gradient(farthest-side, transparent calc(100% - 18px), #000 0);
}
rangegroup::slider-thumb(*) {
  inset: 0;
  margin: 0;
  offset-path: path("M120,9 A111,111 0 0 0 120,231 A111,111 0 0 0 120,9");
  offset-distance:
    var(--_blink-rangegroup-prototype-thumb-position, var(--circular-position));
  offset-anchor: center;
  offset-rotate: 0deg;
  border: 3px solid #0a84ff;
  background: white;
}
rangegroup::slider-thumb(1) {
  --circular-position: var(--circular-thumb-1-position, 0%);
}
rangegroup::slider-thumb(2) {
  --circular-position: var(--circular-thumb-2-position, 75%);
}
`}
        />
        <CodeSnippet
            lang="javascript"
            code={`
const group = document.querySelector("#circular-range");
let activePointerId = null;
let dragStartProgress = 0;
let accumulatedAngle = 0;
let lastAngle = 0;

/* Authored experiment: 0% is 12 o'clock and values increase counterclockwise. */
const pointerToAngle = event => {
  const rect = group.getBoundingClientRect();
  const x = event.clientX - (rect.left + rect.width / 2);
  const y = event.clientY - (rect.top + rect.height / 2);
  const clockwise = (Math.atan2(y, x) + Math.PI / 2 + Math.PI * 2) % (Math.PI * 2);
  return (Math.PI * 2 - clockwise) % (Math.PI * 2);
};
const unwrapDelta = (next, previous) => {
  let delta = next - previous;
  if (delta > Math.PI) delta -= Math.PI * 2;
  if (delta < -Math.PI) delta += Math.PI * 2;
  return delta;
};
const update = () => {
  const [start, end] = group.values;
  group.style.setProperty("--circular-thumb-1-position", \`\${start}%\`);
  group.style.setProperty("--circular-thumb-2-position", \`\${end}%\`);
  group.style.setProperty("--circular-segment-size", \`\${end - start}%\`);
};
const applyProgress = progress => {
  const clamped = Math.max(0, Math.min(1, progress));
  group.setRangeValue(1, clamped * 100);
  update();
};

group.addEventListener("pointerdown", event => {
  event.preventDefault();
  event.stopPropagation();
  const angle = pointerToAngle(event);
  const progress = angle / (Math.PI * 2);
  activePointerId = event.pointerId;
  group.getRangeInput(1).focus();
  group.setPointerCapture(event.pointerId);
  applyProgress(progress);
  dragStartProgress = group.values[1] / 100;
  accumulatedAngle = 0;
  lastAngle = angle;
}, { capture: true });

group.addEventListener("pointermove", event => {
  if (event.pointerId !== activePointerId) return;
  event.preventDefault();
  event.stopPropagation();
  const angle = pointerToAngle(event);
  accumulatedAngle += unwrapDelta(angle, lastAngle);
  lastAngle = angle;
  applyProgress(dragStartProgress + accumulatedAngle / (Math.PI * 2));
}, { capture: true });

const finish = event => {
  if (event.pointerId !== activePointerId) return;
  activePointerId = null;
};
group.addEventListener("pointerup", finish, { capture: true });
group.addEventListener("pointercancel", finish, { capture: true });
update();
`}
        />
    </ExampleCodeBlock>
    <script is:inline slot="runtime">
        (() => {
            const init = () => {
                const group = document.querySelector("#circular-range");
                const startOutput = document.querySelector("#circ-start");
                const endOutput = document.querySelector("#circ-end");
                if (!group || !startOutput || !endOutput) return;

                let activePointerId = null;
                let dragStartProgress = 0;
                let dragAccumulatedAngle = 0;
                let lastAngle = 0;

                const updateReadout = () => {
                    const [start, end] = group.values;
                    group.style.setProperty("--circular-thumb-1-position", `${start}%`);
                    group.style.setProperty("--circular-thumb-2-position", `${end}%`);
                    group.style.setProperty("--circular-segment-size", `${end - start}%`);
                    startOutput.textContent = Math.round(start);
                    endOutput.textContent = Math.round(end);
                };
                const clamp01 = (value) => Math.max(0, Math.min(1, value));
                const pointerToAngle = (event) => {
                    const rect = group.getBoundingClientRect();
                    const x = event.clientX - (rect.left + rect.width / 2);
                    const y = event.clientY - (rect.top + rect.height / 2);
                    const clockwise = (Math.atan2(y, x) + Math.PI / 2 + Math.PI * 2) % (Math.PI * 2);
                    return (Math.PI * 2 - clockwise) % (Math.PI * 2);
                };
                const unwrapDelta = (next, previous) => {
                    let delta = next - previous;
                    if (delta > Math.PI) delta -= Math.PI * 2;
                    if (delta < -Math.PI) delta += Math.PI * 2;
                    return delta;
                };
                const applyProgress = (progress) => {
                    group.setRangeValue(1, clamp01(progress) * 100);
                    updateReadout();
                };
                const handlePointerDown = (event) => {
                    if (event.button !== 0) return;
                    event.preventDefault();
                    event.stopPropagation();
                    const angle = pointerToAngle(event);
                    const progress = angle / (Math.PI * 2);
                    activePointerId = event.pointerId;
                    group.getRangeInput(1)?.focus();
                    group.setPointerCapture(event.pointerId);
                    applyProgress(progress);
                    dragStartProgress = group.values[1] / 100;
                    dragAccumulatedAngle = 0;
                    lastAngle = angle;
                };
                const handlePointerMove = (event) => {
                    if (event.pointerId !== activePointerId) return;
                    event.preventDefault();
                    event.stopPropagation();
                    const nextAngle = pointerToAngle(event);
                    dragAccumulatedAngle += unwrapDelta(nextAngle, lastAngle);
                    lastAngle = nextAngle;
                    applyProgress(dragStartProgress + dragAccumulatedAngle / (Math.PI * 2));
                };
                const handlePointerUp = (event) => {
                    if (event.pointerId !== activePointerId) return;
                    if (group.hasPointerCapture(event.pointerId)) {
                        group.releasePointerCapture(event.pointerId);
                    }
                    activePointerId = null;
                };

                group.addEventListener("pointerdown", handlePointerDown, {
                    capture: true,
                    passive: false,
                });
                group.addEventListener("pointermove", handlePointerMove, {
                    capture: true,
                    passive: false,
                });
                group.addEventListener("pointerup", handlePointerUp, { capture: true });
                group.addEventListener("pointercancel", handlePointerUp, { capture: true });
                group.addEventListener("lostpointercapture", handlePointerUp, { capture: true });
                group
                    .querySelectorAll('input[type="range"]')
                    .forEach((input) => input.addEventListener("input", updateReadout));
                updateReadout();
            };
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init, { once: true });
            } else {
                init();
            }
        })();
    </script>
</ExampleSection>
