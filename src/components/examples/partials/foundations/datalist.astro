---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="datalist" eyebrow="Foundations" title="Datalist integration" status="partial">
    <Fragment slot="description">
        Pair the component with a <code>&lt;datalist&gt;</code> to snap values to discrete options. The component also enforces
        a minimum distance of 25 between handles via
        <code>stepbetween="25"</code>.
    </Fragment>
    <div slot="demo">
        <style is:global>
            .rating-tick-output {
                position: relative;
                block-size: 1rem;
                margin-block-start: -7px;
                color: var(--text-muted);
                font-size: 0.75rem;
                line-height: 1;
                pointer-events: none;
            }
            .rating-tick-output span {
                position: absolute;
                inset-inline-start: var(--tick-position);
                transform: translateX(-50%);
            }
            .rating-tick-output span::before {
                display: block;
                inline-size: 1px;
                block-size: 6px;
                margin: 0 auto 0.25rem;
                background: currentColor;
                content: "";
            }
        </style>
        <rangegroup id="rating-range" min="0" max="100" list="rating-ticks" stepbetween="25">
            <legend class="visually-hidden">Rating range</legend>
            <label class="visually-hidden">
                Minimum rating
                <input type="range" name="rating-min" value="25" />
            </label>
            <label class="visually-hidden">
                Maximum rating
                <input type="range" name="rating-max" value="75" />
            </label>
        </rangegroup>
        <datalist id="rating-ticks">
            <option value="0" label="0%"></option>
            <option value="25"></option>
            <option value="50" label="50%"></option>
            <option value="75"></option>
            <option value="100" label="100%"></option>
        </datalist>
        <div class="rating-tick-output" aria-hidden="true">
            <span style="--tick-position: 0%">0%</span>
            <span style="--tick-position: 25%">25</span>
            <span style="--tick-position: 50%">50%</span>
            <span style="--tick-position: 75%">75</span>
            <span style="--tick-position: 100%">100%</span>
        </div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup min="0" max="100" list="rating-ticks" stepbetween="25">
  <label>Minimum rating <input type="range" value="25"></label>
  <label>Maximum rating <input type="range" value="75"></label>
</rangegroup>
<datalist id="rating-ticks">
  <option value="0" label="0%"></option>
  <option value="25"></option>
  <option value="50" label="50%"></option>
  <option value="75"></option>
  <option value="100" label="100%"></option>
</datalist>

<!-- Author-owned until native tick labels are available. -->
<div class="rating-tick-output" aria-hidden="true">
  <span style="--tick-position: 0%">0%</span>
  <span style="--tick-position: 25%">25</span>
  <span style="--tick-position: 50%">50%</span>
  <span style="--tick-position: 75%">75</span>
  <span style="--tick-position: 100%">100%</span>
</div>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
/* The rangegroup uses its native track, segment, thumb, and tick styles. */

/* Author-owned labels reproduce the original demo until
   ::slider-tick-label is implemented. */
.rating-tick-output {
  position: relative;
  block-size: 1rem;
  margin-block-start: -7px;
  color: var(--text-muted);
  font-size: .75rem;
  line-height: 1;
  pointer-events: none;
}
.rating-tick-output span {
  position: absolute;
  inset-inline-start: var(--tick-position);
  transform: translateX(-50%);
}
.rating-tick-output span::before {
  display: block;
  inline-size: 1px;
  block-size: 6px;
  margin: 0 auto .25rem;
  background: currentColor;
  content: "";
}
`}
        />
    </ExampleCodeBlock>
</ExampleSection>
