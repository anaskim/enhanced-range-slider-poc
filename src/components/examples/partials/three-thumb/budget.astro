---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection
    id="budget"
    eyebrow="Three-plus thumb patterns"
    title="Budget allocator"
    runtimeRequires={["core", "convenienceApi"]}
>
    <Fragment slot="description">
        A complete visual transformation. Three thumbs split a 0&ndash;100 range into four colored budget bars, with
        category labels centered on each segment. An <code>aria-live</code> region announces changes for assistive tech.
    </Fragment>
    <div slot="demo" style="position: relative">
        <style is:global>
            #budget-range {
                --track-height: 50px;
                --thumb-size: 36px;
            }
            #budget-range::slider-track {
                border-radius: 25px;
            }
            #budget-range::slider-segment {
                border-radius: 0;
            }
            #budget-range::slider-thumb(*) {
                border: 4px solid #ffffff;
                background-color: white;
                background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='none' stroke='%230b1220' stroke-linecap='round' stroke-linejoin='bevel' stroke-width='1.5' d='M15.3 16.78l4.11-4.11a1 1 0 000-1.41l-4-4M8.7 7.22L4.59 11.33a1 1 0 000 1.41l4 4'/%3E%3C/svg%3E");
                background-position: center;
                background-repeat: no-repeat;
                background-size: 60%;
                box-shadow:
                    0 4px 6px -1px rgba(0, 0, 0, 0.3),
                    0 2px 4px -1px rgba(0, 0, 0, 0.1);
            }

            #budget-range::slider-segment(1) {
                border-radius: 25px 0 0 25px;
                background-color: #e53935;
            }
            #budget-range::slider-segment(2) {
                background-color: #8e24aa;
            }
            #budget-range::slider-segment(3) {
                background-color: #f57c00;
            }
            #budget-range::slider-segment(4) {
                border-radius: 0 25px 25px 0;
                background-color: #3949ab;
            }

            .budget-labels {
                position: absolute;
                inset: 0;
                pointer-events: none;
            }
            .budget-label {
                position: absolute;
                top: 0;
                left: var(--budget-label-center);
                transform: none;
                translate: -50% 25%;
                color: white;
                text-align: center;
                font-size: 0.875rem;
                text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
                line-height: 1.2;
                pointer-events: none;
                z-index: 1;
            }
            #budget-label-0 {
                --budget-label-center: 12.5%;
            }
            #budget-label-1 {
                --budget-label-center: 37.5%;
            }
            #budget-label-2 {
                --budget-label-center: 62.5%;
            }
            #budget-label-3 {
                --budget-label-center: 87.5%;
            }

            .budget-label strong {
                font-size: 1rem;
                font-weight: 700;
            }

            @media (max-width: 700px) {
                #budget-range {
                    --track-height: 44px;
                    --thumb-size: 32px;
                }
                #budget-range::slider-track {
                    border-radius: 22px;
                }
                #budget-range::slider-segment(1) {
                    border-radius: 22px 0 0 22px;
                }
                #budget-range::slider-segment(4) {
                    border-radius: 0 22px 22px 0;
                }
                .budget-label {
                    font-size: 0.76rem;
                    line-height: 1.1;
                    translate: -50% 30%;
                }
                .budget-label strong {
                    font-size: 0.86rem;
                }
            }

            @media (max-width: 420px) {
                .budget-label {
                    font-size: 0.66rem;
                    line-height: 1;
                    translate: -50% 36%;
                }
                .budget-label strong {
                    display: none;
                }
            }
        </style>
        <div class="budget-range-wrapper">
            <rangegroup id="budget-range" min="0" max="100">
                <legend class="visually-hidden">Budget allocator</legend>
                <label class="visually-hidden">
                    Groceries/Rent separator
                    <input type="range" value="25" />
                </label>
                <label class="visually-hidden">
                    Rent/Transport separator
                    <input type="range" value="50" />
                </label>
                <label class="visually-hidden">
                    Transport/Internet separator
                    <input type="range" value="75" />
                </label>
            </rangegroup>
            <div id="budget-labels" class="budget-labels">
                <div id="budget-label-0" class="budget-label"></div>
                <div id="budget-label-1" class="budget-label"></div>
                <div id="budget-label-2" class="budget-label"></div>
                <div id="budget-label-3" class="budget-label"></div>
            </div>
        </div>
        <div id="budget-announcer" aria-live="polite" role="status" class="visually-hidden"></div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup id="budget-range" min="0" max="100">
  <legend>Budget allocator</legend>
  <label>Groceries / Rent     <input type="range" value="25"></label>
  <label>Rent / Transport     <input type="range" value="50"></label>
  <label>Transport / Internet <input type="range" value="75"></label>
</rangegroup>

<div class="budget-labels">
  <div class="budget-label" id="budget-label-0"></div>
  <div class="budget-label" id="budget-label-1"></div>
  <div class="budget-label" id="budget-label-2"></div>
  <div class="budget-label" id="budget-label-3"></div>
</div>

<!-- announces the split for assistive tech -->
<div id="budget-announcer" aria-live="polite" role="status"></div>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
rangegroup {
  --track-height: 50px;
  --thumb-size: 36px;
}
rangegroup::slider-track {
  block-size: 50px;
  border-radius: 25px;
}
rangegroup::slider-segment { border-radius: 0; }

rangegroup::slider-segment(1) {
  border-radius: 25px 0 0 25px;
  background-color: #e53935;
}
rangegroup::slider-segment(2) { background-color: #8e24aa; }
rangegroup::slider-segment(3) { background-color: #f57c00; }
rangegroup::slider-segment(4) {
  border-radius: 0 25px 25px 0;
  background-color: #3949ab;
}

rangegroup::slider-thumb(*) {
  inline-size: 36px;
  block-size: 36px;
  border: 4px solid white;
  background-color: white;
  background-image: url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='none' stroke='%230b1220' stroke-linecap='round' stroke-linejoin='bevel' stroke-width='1.5' d='M15.3 16.78l4.11-4.11a1 1 0 000-1.41l-4-4M8.7 7.22L4.59 11.33a1 1 0 000 1.41l4 4'/%3E%3C/svg%3E");
  background-position: center;
  background-repeat: no-repeat;
  background-size: 60%;
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, .3),
    0 2px 4px -1px rgba(0, 0, 0, .1);
}

.budget-labels {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.budget-label {
  position: absolute;
  top: 0;
  left: var(--budget-label-center);
  translate: -50% 25%;
  color: white;
  text-align: center;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .5);
  pointer-events: none;
}
#budget-label-0 { --budget-label-center: 12.5%; }
#budget-label-1 { --budget-label-center: 37.5%; }
#budget-label-2 { --budget-label-center: 62.5%; }
#budget-label-3 { --budget-label-center: 87.5%; }

@media (max-width: 700px) {
  rangegroup {
    --track-height: 44px;
    --thumb-size: 32px;
  }
  rangegroup::slider-track {
    block-size: 44px;
    border-radius: 22px;
  }
  rangegroup::slider-segment(1) { border-radius: 22px 0 0 22px; }
  rangegroup::slider-segment(4) { border-radius: 0 22px 22px 0; }
  rangegroup::slider-thumb(*) {
    inline-size: 32px;
    block-size: 32px;
  }
}
`}
        />
        <CodeSnippet
            lang="javascript"
            code={`
const rg        = document.querySelector("#budget-range");
const announcer = document.querySelector("#budget-announcer");
const labels    = document.querySelectorAll(".budget-label");
const categories = ["Groceries", "Rent", "Transport", "Internet"];

const update = () => {
  const stops = [0, ...rg.values, 100];
  let announcement = "Budget updated. ";
  labels.forEach((label, i) => {
    const pct = Math.round(stops[i + 1] - stops[i]);
    label.style.setProperty(
      "--budget-label-center",
      (stops[i] + stops[i + 1]) / 2 + "%"
    );
    label.replaceChildren();
    const categoryName = document.createElement("strong");
    categoryName.textContent = categories[i];
    label.append(categoryName, document.createElement("br"), document.createTextNode(pct + "%"));
    announcement += categories[i] + ": " + pct + "%. ";
  });
  // Live region updates on change only — announcing on every input event
  // floods assistive tech during a drag or held arrow key.
  return announcement.trim();
};

rg.addEventListener("input", () => { update(); });
rg.addEventListener("change", () => { announcer.textContent = update(); });
update();
`}
        />
    </ExampleCodeBlock>
    <script is:inline slot="runtime">
        (() => {
            const init = () => {
                const rg = document.querySelector("#budget-range");
                const announcer = document.querySelector("#budget-announcer");
                const labels = document.querySelectorAll(".budget-label");
                const categories = ["Groceries", "Rent", "Transport", "Internet"];

                const updateLabels = () => {
                    const stops = [0, ...rg.values, 100];
                    let announcement = "Budget updated. ";
                    labels.forEach((label, i) => {
                        const pct = Math.round(stops[i + 1] - stops[i]);
                        label.style.setProperty("--budget-label-center", `${(stops[i] + stops[i + 1]) / 2}%`);
                        label.replaceChildren();
                        const categoryName = document.createElement("strong");
                        categoryName.textContent = categories[i];
                        label.append(categoryName, document.createElement("br"), document.createTextNode(`${pct}%`));
                        announcement += categories[i] + ": " + pct + "%. ";
                    });
                    return announcement.trim();
                };

                // Visual labels track every input event; the live region only
                // speaks when the interaction commits, so it does not drown out
                // the slider's own value announcements during a drag.
                rg.addEventListener("input", updateLabels);
                rg.addEventListener("change", () => {
                    announcer.textContent = updateLabels();
                });
                updateLabels();
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init, { once: true });
            } else {
                init();
            }
        })();
    </script>
</ExampleSection>
