---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection
    id="opening-hours-segment"
    eyebrow="Three-plus thumb patterns"
    title="Opening hours selector (segment drag)"
    status="gap"
>
    <Fragment slot="description">
        The same four-handle timeline with <code>interaction="range"</code>. Pressing inside a shift drags that shift as
        a block: both of its bounding thumbs move together and the duration stays fixed, while the other two thumbs stay
        put. With more than two thumbs the pointer position is what decides which interval moves &mdash; the case the
        explainer previously called ambiguous. Pressing before or after all four thumbs pulls the closest shift to the
        pointer rather than jumping a thumb, and a dragged shift is clamped by its neighbours and by
        <code>stepbetween</code>.
    </Fragment>
    <Fragment slot="disclosure">
        The separate <code>RangeGroupSegmentDragging</code> runtime flag makes all three interior segments draggable: the
        two open shifts and the closed gap between them. This design intends only the teal shifts to move. A public design
        must let authors identify movable intervals without inferring semantics from color, and must define keyboard, accessibility,
        focus, and event behavior for the selected pair.
    </Fragment>
    <div slot="demo" class="hours-card">
        <style is:global>
            /* Base layout, pill and readout styles are shared with the opening hours example above. */
            #opening-hours-segment-range {
                --track-height: 4px;
                --thumb-size: 16px;
                position: relative;
                z-index: 1;
            }
            #opening-hours-segment-range::slider-segment {
                background-color: var(--hours-closed);
            }
            #opening-hours-segment-range::slider-segment(2),
            #opening-hours-segment-range::slider-segment(4) {
                background-color: var(--hours-open);
                cursor: grab;
            }
            #opening-hours-segment-range::slider-thumb(*) {
                border: 1px solid rgb(0 0 0 / 0.18);
                box-shadow:
                    0 1px 2px rgb(0 0 0 / 0.35),
                    inset 0 0 0 1px rgb(255 255 255 / 0.8);
                transition: transform 0.1s ease-in-out;
            }
            #opening-hours-segment-range::slider-thumb(1),
            #opening-hours-segment-range::slider-thumb(3) {
                background-color: var(--hours-open);
                background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='white'><path d='M5.5 3.4v9.2L13 8z'/></svg>");
                background-position: 58% center;
                background-repeat: no-repeat;
                background-size: 58%;
                border-color: color-mix(in oklab, var(--hours-open) 70%, black 25%);
            }
            #opening-hours-segment-range::slider-thumb(2),
            #opening-hours-segment-range::slider-thumb(4) {
                background-color: #475569;
                background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='white'><rect x='4.5' y='4.5' width='7' height='7' rx='1.2'/></svg>");
                background-position: center;
                background-repeat: no-repeat;
                background-size: 55%;
                border-color: #334155;
            }
            #opening-hours-segment-range::slider-thumb(*):hover {
                transform: scale(1.1);
            }
            .hours-segment-shift-am {
                left: var(--hours-am-center);
                translate: -50% 0;
            }
            .hours-segment-shift-pm {
                left: var(--hours-pm-center);
                translate: -50% 0;
            }

            @media (max-width: 700px) {
                .hours-segment-shift-am,
                .hours-segment-shift-pm {
                    translate: -50% -8px;
                }
            }
        </style>
        <div class="hours-stage">
            <div class="hours-atmosphere" aria-hidden="true"></div>
            <svg class="hours-icon hours-icon-sun" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="12" r="4.5"></circle>
                <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="12" y1="2.5" x2="12" y2="5"></line>
                    <line x1="12" y1="19" x2="12" y2="21.5"></line>
                    <line x1="2.5" y1="12" x2="5" y2="12"></line>
                    <line x1="19" y1="12" x2="21.5" y2="12"></line>
                    <line x1="5.4" y1="5.4" x2="7.2" y2="7.2"></line>
                    <line x1="16.8" y1="16.8" x2="18.6" y2="18.6"></line>
                    <line x1="18.6" y1="5.4" x2="16.8" y2="7.2"></line>
                    <line x1="7.2" y1="16.8" x2="5.4" y2="18.6"></line>
                </g>
            </svg>
            <svg class="hours-icon hours-icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.5 14.5A9 9 0 0 1 9.5 3.5a.5.5 0 0 0-.65-.65 9 9 0 1 0 12.3 12.3.5.5 0 0 0-.65-.65z"></path>
            </svg>
            <rangegroup id="opening-hours-segment-range" min="480" max="1320" list="hours-ticks" stepbetween="30">
                <legend class="visually-hidden">Opening hours endpoints</legend>
                <label class="visually-hidden">
                    AM Open <input type="range" min="480" max="1320" value="540" />
                </label>
                <label class="visually-hidden">
                    AM Close <input type="range" min="480" max="1320" value="720" />
                </label>
                <label class="visually-hidden">
                    PM Open <input type="range" min="480" max="1320" value="780" />
                </label>
                <label class="visually-hidden">
                    PM Close <input type="range" min="480" max="1320" value="1020" />
                </label>
            </rangegroup>
            <div class="hours-ticks" aria-hidden="true"></div>
            <div class="hours-scale" aria-hidden="true">
                <span style="--hours-position: 0%">8 AM</span>
                <span style="--hours-position: 7.1429%">9 AM</span>
                <span style="--hours-position: 14.2857%">10 AM</span>
                <span style="--hours-position: 21.4286%">11 AM</span>
                <span style="--hours-position: 28.5714%">12 PM</span>
                <span style="--hours-position: 35.7143%">1 PM</span>
                <span style="--hours-position: 42.8571%">2 PM</span>
                <span style="--hours-position: 50%">3 PM</span>
                <span style="--hours-position: 57.1429%">4 PM</span>
                <span style="--hours-position: 64.2857%">5 PM</span>
                <span style="--hours-position: 71.4286%">6 PM</span>
                <span style="--hours-position: 78.5714%">7 PM</span>
                <span style="--hours-position: 85.7143%">8 PM</span>
                <span style="--hours-position: 92.8571%">9 PM</span>
                <span style="--hours-position: 100%">10 PM</span>
            </div>
            <div class="hours-shift-label hours-segment-shift-am" aria-hidden="true">
                Morning shift<strong id="hours-segment-shift-am-duration">3h 0m</strong>
            </div>
            <div class="hours-shift-label hours-segment-shift-pm" aria-hidden="true">
                Afternoon shift<strong id="hours-segment-shift-pm-duration">4h 0m</strong>
            </div>
        </div>
        <div class="hours-readout">
            <div class="hours-readout-cell">
                <span class="hours-readout-label">Morning shift</span>
                <span class="hours-readout-value" id="hours-segment-am">9:00 AM – 12:00 PM</span>
            </div>
            <div class="hours-readout-cell">
                <span class="hours-readout-label">Afternoon shift</span>
                <span class="hours-readout-value" id="hours-segment-pm">1:00 PM – 5:00 PM</span>
            </div>
        </div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup id="opening-hours-segment-range" min="480" max="1320" list="hours-ticks"
            stepbetween="30">
  <legend>Opening hours endpoints</legend>
  <label>AM Open <input type="range" min="480" max="1320" value="540"></label>
  <label>AM Close <input type="range" min="480" max="1320" value="720"></label>
  <label>PM Open <input type="range" min="480" max="1320" value="780"></label>
  <label>PM Close <input type="range" min="480" max="1320" value="1020"></label>
</rangegroup>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
.hours-card {
  --hours-open: #14b8a6;
  --hours-closed: #d6dbe2;
  --hours-day: #f59e0b;
  --hours-night: #4f46e5;
}
rangegroup::slider-segment { background-color: var(--hours-closed); }
rangegroup::slider-segment(2),
rangegroup::slider-segment(4) {
  background-color: var(--hours-open);
  cursor: grab;
}
rangegroup::slider-thumb(*) {
  inline-size: 16px;
  block-size: 16px;
  border: 1px solid rgb(0 0 0 / .18);
  border-radius: 50%;
  box-shadow:
    0 1px 2px rgb(0 0 0 / .35),
    inset 0 0 0 1px rgb(255 255 255 / .8);
}
rangegroup::slider-thumb(1),
rangegroup::slider-thumb(3) {
  background-color: var(--hours-open);
  background-image: url("...play arrow svg...");
  border-color: color-mix(in oklab, var(--hours-open) 70%, black 25%);
}
rangegroup::slider-thumb(2),
rangegroup::slider-thumb(4) {
  background-color: #475569;
  background-image: url("...stop square svg...");
  border-color: #334155;
}
.hours-atmosphere {
  background: linear-gradient(to right, #fde68a 0%, #fbbf24 25%, #fb923c 55%, #6366f1 100%);
}
.hours-icon-sun { color: var(--hours-day); }
.hours-icon-moon { color: var(--hours-night); }
.hours-shift-label {
  padding: 5px 11px;
  border: 1px solid color-mix(in oklab, var(--hours-open) 30%, var(--border));
  border-radius: 999px;
  background: white;
  color: #0b1220;
}
.hours-segment-shift-am { left: var(--hours-am-center); }
.hours-segment-shift-pm { left: var(--hours-pm-center); }
`}
        />
        <CodeSnippet
            lang="javascript"
            code={`
const rg = document.querySelector("#opening-hours-segment-range");
const card = document.querySelector("#opening-hours-segment .hours-card");

rg.querySelectorAll('input[type="range"]').forEach((input) => {
  input.addEventListener("input", () => {
    const [amS, amE, pmS, pmE] = rg.values;
    console.log({
      morningDuration: amE - amS,
      afternoonDuration: pmE - pmS,
    });
  });
});
`}
        />
    </ExampleCodeBlock>
    <script is:inline slot="runtime">
        (() => {
            const init = () => {
                const rg = document.querySelector("#opening-hours-segment-range");
                const card = document.querySelector("#opening-hours-segment .hours-card");
                const amOut = document.querySelector("#hours-segment-am");
                const pmOut = document.querySelector("#hours-segment-pm");
                const amLabel = document.querySelector(".hours-segment-shift-am strong");
                const pmLabel = document.querySelector(".hours-segment-shift-pm strong");
                if (!rg || !card || !amOut || !pmOut || !amLabel || !pmLabel) return;

                const minutesToTime = (m) => {
                    const h = Math.floor(m / 60);
                    const ampm = h >= 12 ? "PM" : "AM";
                    const displayH = h % 12 === 0 ? 12 : h % 12;
                    return `${displayH}:${String(m % 60).padStart(2, "0")} ${ampm}`;
                };
                const minutesToDuration = (mins) => `${Math.floor(mins / 60)}h ${mins % 60}m`;
                const toPercent = (value) => ((value - 480) / (1320 - 480)) * 100;

                const update = () => {
                    const [amS, amE, pmS, pmE] = rg.values;
                    card.style.setProperty("--hours-am-center", `${(toPercent(amS) + toPercent(amE)) / 2}%`);
                    card.style.setProperty("--hours-pm-center", `${(toPercent(pmS) + toPercent(pmE)) / 2}%`);
                    amOut.textContent = `${minutesToTime(amS)} – ${minutesToTime(amE)}`;
                    pmOut.textContent = `${minutesToTime(pmS)} – ${minutesToTime(pmE)}`;
                    amLabel.textContent = minutesToDuration(amE - amS);
                    pmLabel.textContent = minutesToDuration(pmE - pmS);
                };
                rg.querySelectorAll('input[type="range"]').forEach((input) => {
                    input.addEventListener("input", update);
                });
                update();
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init, { once: true });
            } else {
                init();
            }
        })();
    </script>
</ExampleSection>
