---
import ExampleSection from "../../ExampleSection.astro";
import ExampleCodeBlock from "../../ExampleCodeBlock.astro";
import CodeSnippet from "../../CodeSnippet.astro";
---

<ExampleSection id="process-flow" eyebrow="Three-plus thumb patterns" title="Three-handle process flow">
    <Fragment slot="description">
        Three handles and styled ticks represent the boundaries between phases in a process. Each major tick gets its
        own colour, signaling the phase it marks.
    </Fragment>
    <div slot="demo">
        <style is:global>
            .process-flow-milestones {
                position: relative;
                block-size: 2.5rem;
                margin-block-start: -7px;
                color: var(--text-muted);
                font-size: 0.75rem;
                line-height: 1;
                pointer-events: none;
            }
            .process-flow-milestones span {
                position: absolute;
                inset-inline-start: var(--process-position);
                translate: -50% 0;
                color: var(--process-label-color);
                white-space: nowrap;
            }
            .process-flow-milestones span::before {
                display: block;
                inline-size: 2px;
                block-size: 12px;
                margin: 0 auto 0.35rem;
                background: var(--process-tick-color);
                content: "";
            }
            .process-flow-milestones span:first-child {
                translate: 0 0;
            }
            .process-flow-milestones span:first-child::before {
                margin-inline-start: 0;
            }
            .process-flow-milestones span:last-child {
                translate: -100% 0;
            }
            .process-flow-milestones span:last-child::before {
                margin-inline-end: 0;
            }
        </style>
        <rangegroup id="multiphase-example" min="0" max="3" list="multiphase-datalist">
            <legend class="visually-hidden">Process flow</legend>
            <label class="visually-hidden">
                Review
                <input type="range" min="0" max="3" step="1" value="1" />
            </label>
            <label class="visually-hidden">
                Approved start
                <input type="range" min="0" max="3" step="1" value="2" />
            </label>
            <label class="visually-hidden">
                Approved end
                <input type="range" min="0" max="3" step="1" value="2" />
            </label>
        </rangegroup>
        <datalist id="multiphase-datalist">
            <option value="0" label="Start"></option>
            <option value="1" label="Review"></option>
            <option value="2" label="Approved"></option>
            <option value="3" label="Complete"></option>
        </datalist>
        <div class="process-flow-milestones" aria-hidden="true">
            <span style="--process-position: 0%; --process-tick-color: #aaa; --process-label-color: #777">Start</span>
            <span style="--process-position: 33.3333%; --process-tick-color: #d97706; --process-label-color: #d97706"
                >Review</span
            >
            <span style="--process-position: 66.6667%; --process-tick-color: #16a34a; --process-label-color: #16a34a"
                >Approved</span
            >
            <span style="--process-position: 100%; --process-tick-color: #2563eb; --process-label-color: #2563eb"
                >Complete</span
            >
        </div>
    </div>
    <ExampleCodeBlock slot="code">
        <CodeSnippet
            lang="html"
            code={`
<rangegroup min="0" max="3" list="multiphase-datalist">
  <legend>Process flow</legend>
  <label>Review         <input type="range" min="0" max="3" step="1" value="1"></label>
  <label>Approved start <input type="range" min="0" max="3" step="1" value="2"></label>
  <label>Approved end   <input type="range" min="0" max="3" step="1" value="2"></label>
</rangegroup>

<datalist id="multiphase-datalist">
  <option value="0"   label="Start"></option>
  <option value="1" label="Review"></option>
  <option value="2" label="Approved"></option>
  <option value="3" label="Complete"></option>
</datalist>

<div class="process-flow-milestones" aria-hidden="true">
  <span style="--process-position: 0%; --process-tick-color: #aaa; --process-label-color: #777">Start</span>
  <span style="--process-position: 33.3333%; --process-tick-color: #d97706; --process-label-color: #d97706">Review</span>
  <span style="--process-position: 66.6667%; --process-tick-color: #16a34a; --process-label-color: #16a34a">Approved</span>
  <span style="--process-position: 100%; --process-tick-color: #2563eb; --process-label-color: #2563eb">Complete</span>
</div>
`}
        />
        <CodeSnippet
            lang="css"
            code={`
/* The track, segments, and thumbs use their UA styles.
   Landmarks are authored until public tick pseudos are available. */
.process-flow-milestones {
  position: relative;
  block-size: 2.5rem;
  margin-block-start: -7px;
  color: var(--text-muted);
  font-size: .75rem;
  line-height: 1;
  pointer-events: none;
}
.process-flow-milestones span {
  position: absolute;
  inset-inline-start: var(--process-position);
  translate: -50% 0;
  color: var(--process-label-color);
  white-space: nowrap;
}
.process-flow-milestones span::before {
  display: block;
  inline-size: 2px;
  block-size: 12px;
  margin: 0 auto .35rem;
  background: var(--process-tick-color);
  content: "";
}
.process-flow-milestones span:first-child { translate: 0 0; }
.process-flow-milestones span:last-child { translate: -100% 0; }
`}
        />
    </ExampleCodeBlock>
</ExampleSection>
