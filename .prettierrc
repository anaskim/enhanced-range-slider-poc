{
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "all",
    "singleQuote": false,
    "jsxSingleQuote": false,
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        {
            "files": ["*.css", "*.scss"],
            "options": {
                "tabWidth": 4,
                "useTabs": false,
                "trailingComma": "all",
                "singleQuote": false
            }
        }
    ]
}
